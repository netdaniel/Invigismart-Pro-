{
  "name": "invigismart.online (cPanel FTPS)",
  "host": "dahost11.vpslocal.co.za",
  "protocol": "ftp",
  "port": 21,
  "secure": true,
  "username": "YOUR_CPANEL_USER",
  "password": "YOUR_FTP_PASSWORD",
  "remotePath": "/",
  "uploadOnSave": false,
  "useTempFile": true,
  "openSsh": false,
  "connectTimeout": 20000,
  "concurrency": 2,
  "ignore": [
    ".git/**",
    ".vscode/**",
    ".deploy.env",
    ".env",
    ".env.*",
    "server/**",
    "deploy/**",
    "*.db",
    "*.db-journal",
    "*.db-wal",
    "*.db-shm",
    "__pycache__/**",
    "*.pyc",
    "invigismart-backup-*.json",
    "DEPLOY.md",
    "README.md",
    "_config.yml",
    "CNAME",
    ".gitignore"
  ]
}

