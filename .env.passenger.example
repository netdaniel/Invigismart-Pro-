# ---------------------------------------------------------------------------
# Invigismart Pro - configuration for cPanel's "Setup Python App" (Passenger).
#
#   Upload this as  <application root>/.env   (a dotfile: neither Apache nor the
#   server's own static handler will serve it)
#
#   ...or keep it out of the web root entirely and point INVIGISMART_ENV at it:
#   setInvigismartEnv in passenger_wsgi.py's docstring shows the one-liner.
#
# passenger_wsgi.py reads this file at import, before Config() runs, so every
# value here is in effect for the whole process. A variable already present in
# the real environment wins, so cPanel's own "Environment variables" box works
# too. See DEPLOY.md section 13.
#
# HOST/PORT are ignored by Passenger (Apache talks to the app directly); they
# are here so the same file also works with `python3 server/app.py`.
# ---------------------------------------------------------------------------

HOST=127.0.0.1
PORT=8000

# Relative paths are resolved against the application root, NOT the working
# directory, so these land in <app root>/data/ whatever Passenger does. Leave
# them relative: an absolute path hardcodes a /home/username that changes when
# the account moves.
DB_PATH=data/invigismart.db
DOCUMENTS_DIR=data/documents
MAX_DOCUMENT_BYTES=10485760
MAX_DOCUMENTS_PER_USER=50
MAX_DOCUMENT_STORAGE_BYTES=104857600

# --- sessions ---------------------------------------------------------------
# REQUIRED. python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs every school out; keep it.
JWT_SECRET=
ACCESS_TOKEN_TTL=3600
TRIAL_DAYS=14

# --- public URL -------------------------------------------------------------
# REQUIRED, and it must be https: this is what switches on the production
# checks in server/config.py, builds the PayFast return/cancel URLs and is
# recorded as the notify_url on every checkout.
# It is the *website's* origin, because that is where the dashboard reads its
# session token from: return there, not to the API's own hostname. The site's
# /api/* paths reach this Passenger app, so the ITN needs no extra certificate.
APP_BASE_URL=https://invigismart.online

# --- billing ----------------------------------------------------------------
BILLING_PROVIDER=payfast
# REQUIRED, from PayFast -> Settings -> Integration.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# The same passphrase you typed into PayFast. A mismatch rejects every checkout.
# Leave blank ONLY if the account has none, and then set the next line to 1.
PAYFAST_PASSPHRASE=
PAYFAST_ALLOW_NO_PASSPHRASE=0
# 0 = take real money. Keep 1 until one sandbox purchase has worked end to end.
PAYFAST_SANDBOX=1
PAYFAST_FREQUENCY=6
PAYFAST_CYCLES=0
PAYFAST_ITN_VERIFICATION=api
PAYFAST_IP_ALLOWLIST=

# 1 publishes /mock-checkout, where any visitor can mint a free year. It is
# force-disabled while APP_BASE_URL is https, but keep the intent explicit.
ALLOW_MOCK_BILLING=0

# --- plan copy and support --------------------------------------------------
PLAN_NAME="Annual School Unlimited"
PLAN_PRICE_DISPLAY="R1200 / year"
PLAN_PRICE_AMOUNT=1200.00
SUBSCRIPTION_DAYS=365
SUPPORT_EMAIL=daniel@invigismart.online
SUPPORT_PHONE="+27 76 319 3749"
