# ---------------------------------------------------------------------------
# Invigismart Pro backend - example configuration for LOCAL DEVELOPMENT.
# Copy to .env and export the values, e.g.:
#   set -a; . ./.env; set +a; python3 server/app.py
# Every value is optional; the defaults give a working local development server.
#
# Deploying to a real domain? Use .env.production.example instead - it marks the
# values that are required and the server refuses to start on a public https host
# without them. See DEPLOY.md.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# SQLite database holding accounts + subscriptions. Defaults to server/invigismart.db
DB_PATH=

# --- uploaded documents (PDF library) ---------------------------------------
# Where the PDFs themselves are stored. Defaults to server/uploads, which is
# ignored by git; production should use a persistent directory.
DOCUMENTS_DIR=
# One PDF may be this many bytes (default 10 MB).
MAX_DOCUMENT_BYTES=10485760
# Per-account file count and total storage allowance.
MAX_DOCUMENTS_PER_USER=50
MAX_DOCUMENT_STORAGE_BYTES=104857600

# --- sessions ---------------------------------------------------------------
# REQUIRED in production. Random string used to HMAC-sign session tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated at start-up (sessions reset on restart).
JWT_SECRET=
ACCESS_TOKEN_TTL=3600
TRIAL_DAYS=14

# --- billing provider -------------------------------------------------------
# payfast (local, South Africa) | stripe | mock. Blank auto-detects from the
# credentials that are present. With nothing set you get the local mock checkout,
# which is what a development machine wants.
BILLING_PROVIDER=

# --- PayFast (South Africa) --------------------------------------------------
# PayFast supports annual ZAR recurring billing and can cancel a subscription
# through its API, which is what a 12-month licence needs. Leave these blank to
# keep using the mock checkout.
#   Settings -> Integration in your PayFast account.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# 1 = PayFast's sandbox: a full checkout with test cards, no real money.
PAYFAST_SANDBOX=
# 6 = annual, 0 cycles = renew until cancelled.
PAYFAST_FREQUENCY=6
PAYFAST_CYCLES=0
# api | api+signature | signature | off  (see server/payfast.py)
PAYFAST_ITN_VERIFICATION=api
# Only for an account that genuinely has no passphrase set in PayFast: keeps the
# "PAYFAST_PASSPHRASE is not set" production check advisory instead of fatal.
PAYFAST_ALLOW_NO_PASSPHRASE=

# --- Stripe (alternative) ---------------------------------------------------
# With these set, "Renew" opens a real Stripe Checkout and subscription changes
# arrive on POST /api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public base URL used for payment success/cancel redirects. An https value here
# puts the server in production mode: mock billing is force-disabled and the
# start-up safety checks apply.
APP_BASE_URL=

# --- billing mode -----------------------------------------------------------
# 1 = expose /mock-checkout plus the demo activate/expire endpoints.
# Defaults to 1 only while no gateway is configured, and is always ignored on an
# https host (those endpoints grant a free year to anyone with a login).
ALLOW_MOCK_BILLING=

# Escape hatch for a throwaway staging host: 1 skips the production billing
# checks (JWT_SECRET, the gateway credentials - including PAYFAST_PASSPHRASE,
# because a mismatched signature means the checkout is rejected - and
# STRIPE_WEBHOOK_SECRET). Never use it in production: those checks exist because
# the failures are silent.
ALLOW_INSECURE_BILLING=

# --- plan copy shown in the UI ---------------------------------------------
# Values with spaces are quoted: `set -a; . ./.env` is the documented way to
# load this file, and an unquoted "Annual School Unlimited" is run as a command.
PLAN_NAME="Annual School Unlimited"
# Priced in South African Rand (ZAR).
PLAN_PRICE_DISPLAY="R1200 / year"
# The amount actually charged, in ZAR.
PLAN_PRICE_AMOUNT=1200.00
# How long one paid period lasts, in days.
SUBSCRIPTION_DAYS=365

# --- contact details shown on the site --------------------------------------
# Printed in the landing-page footer and FAQ, the dashboard footer and the
# billing panel, so a school knows where to send a payment question. Served
# through /api/health like the plan copy, so all pages always agree.
# Both below are the live values and are used when these are left blank.
SUPPORT_EMAIL=daniel@invigismart.online
# Any way of writing the number works: 076 319 3749, +27 76 319 3749 or
# 0027763193749. The server derives the tel:/WhatsApp link from it.
SUPPORT_PHONE="+27 76 319 3749"
