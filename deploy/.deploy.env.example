# Copy this file to .deploy.env (which is gitignored) and fill in the values.
#
# FTP account password: cPanel -> https://156.155.252.98:2222 -> FTP Accounts.
# Use the account's own password, or create a dedicated FTP account that is
# jailed to public_html so a leaked password cannot reach the whole home dir.

# The server's TLS certificate is issued for this hostname, not for the domain
# or the IP. Keep the hostname so certificate verification stays on.
FTP_HOST=dahost11.vpslocal.co.za

FTP_USER=your_cpanel_user
FTP_PASS='your-ftp-password'

# Path relative to the FTP login root. It depends on how the account is jailed:
#   jailed to docroot, one-account plans (this host, confirmed 2026-10-29):  /
#   primary cPanel login (whole home directory):                            public_html
FTP_REMOTE_DIR=/

# 1 = connect by IP and skip certificate checks (only if the hostname fails).
FTP_INSECURE=0

SITE_URL=https://invigismart.online

# --- backend (deploy/upload-passenger.sh, DEPLOY.md section 13) --------------
# On this host (2026-10-29): the panel user is shfckyzk (DirectAdmin, not
# cPanel), app root /home/shfckyzk/invigismart-api, virtualenv
# /home/shfckyzk/virtualenv/invigismart-api/3.11 - i.e. Python 3.11, code
# outside the docroot. The subdomain's document root is public_html/api and
# holds a CloudLinux Passenger .htaccess pointing at that app root.
#
# An FTP account is jailed to the Path it was created with and cannot go up:
# ".." stays at the root, and an absolute path outside it is "No such file or
# directory". Only a jail that *contains* the app root can upload the backend:
#   Path /home/shfckyzk/invigismart-api  ->  BACKEND_REMOTE_DIR=/
#   Path /home/shfckyzk                  ->  BACKEND_REMOTE_DIR=invigismart-api
# The website's account is jailed to the docroot, and the second one
# (admin@invigismart.online) to /home/shfckyzk/domains/invigismart.online; both
# sit beside the app root rather than above it, so neither can reach it as
# created. Two ways in, neither needing a third account:
#
# 1. Re-point an FTP account: DirectAdmin -> FTP Management -> the account ->
#    Path = /home/shfckyzk/invigismart-api. Then, with "/" as the app root:
#      FTP_USER_BACKEND=admin@invigismart.online
#      FTP_PASS_BACKEND='<that account password>'
#      BACKEND_REMOTE_DIR=/
# 2. Or use the primary panel login, which is not one of the plan's FTP
#    accounts and reaches the whole home directory:
#      FTP_USER_BACKEND=shfckyzk            # panel username, no @domain
#      FTP_PASS_BACKEND=<panel password>    # a 530 means it was the FTP one
#      BACKEND_REMOTE_DIR=invigismart-api
#
# The *_BACKEND names override FTP_USER/FTP_PASS for this script alone, so the
# static upload keeps working with its docroot-jailed account.
#
# ./deploy/upload-passenger.sh --probe lists what a login can actually see
# before anything is uploaded. Or skip FTP entirely:
# ./deploy/upload-passenger.sh --zip, then File Manager's Upload + Extract.
# FTP_USER_BACKEND=
# FTP_PASS_BACKEND=
BACKEND_REMOTE_DIR=invigismart-api

# Hostname the API is served on - only used to verify a deployment.
API_HOST=api.invigismart.online
