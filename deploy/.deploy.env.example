# Copy this file to .deploy.env (which is gitignored) and fill in the values.
#
# FTP account password: cPanel -> https://156.155.252.98:2222 -> FTP Accounts.
# Use the account's own password, or create a dedicated FTP account that is
# jailed to public_html so a leaked password cannot reach the whole home dir.

# The server's TLS certificate is issued for this hostname, not for the domain
# or the IP. Keep the hostname so certificate verification stays on.
FTP_HOST=dahost11.vpslocal.co.za

FTP_USER=your_cpanel_user
FTP_PASS='your-ftp-password'

# Path relative to the FTP login root. It depends on how the account is jailed:
#   jailed to docroot, one-account plans (this host, confirmed 2026-10-29):  /
#   primary cPanel login (whole home directory):                            public_html
FTP_REMOTE_DIR=/

# 1 = connect by IP and skip certificate checks (only if the hostname fails).
FTP_INSECURE=0

SITE_URL=https://invigismart.online

# --- backend (deploy/upload-passenger.sh, DEPLOY.md section 13) --------------
# On this host (2026-10-29): cPanel user shfckyzk, app root
# /home/shfckyzk/invigismart-api, virtualenv /home/shfckyzk/virtualenv/
# invigismart-api/3.11 - i.e. Python 3.11, code outside the docroot. The
# subdomain's document root is public_html/api and holds a CloudLinux
# Passenger .htaccess pointing at that app root. So BACKEND_REMOTE_DIR is only
# "invigismart-api" for a login that starts in the home directory.
#
# A single-account plan jails its one account to the docroot, which puts the app
# root beside it rather than below it and makes FTP useless for the backend. The
# primary cPanel login is *not* one of the plan's FTP accounts, so it still works
# when "FTP Accounts" says "You have reached the limit". Put it in these two
# variables only - that overrides FTP_USER/FTP_PASS for this script alone, so the
# static upload keeps its working docroot-jailed account:
#   FTP_USER_BACKEND=shfckyzk        (cPanel username, no @domain)
#   FTP_PASS_BACKEND=<cPanel password>   (a 530 means it was the FTP account's)
# and then BACKEND_REMOTE_DIR=invigismart-api, because "/" is the home dir there.
# FTP_USER_BACKEND=
# FTP_PASS_BACKEND=
# Or skip FTP entirely: ./deploy/upload-passenger.sh --zip, then File Manager's
# Upload + Extract - no credentials involved.
BACKEND_REMOTE_DIR=/

# Hostname the API is served on - only used to verify a deployment.
API_HOST=api.invigismart.online

# Hostname the API is served on - only used to verify a deployment.
API_HOST=api.invigismart.online
