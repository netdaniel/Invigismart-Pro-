# Copy this file to .deploy.env (which is gitignored) and fill in the values.
#
# FTP account password: cPanel -> https://156.155.252.98:2222 -> FTP Accounts.
# Use the account's own password, or create a dedicated FTP account that is
# jailed to public_html so a leaked password cannot reach the whole home dir.

# The server's TLS certificate is issued for this hostname, not for the domain
# or the IP. Keep the hostname so certificate verification stays on.
FTP_HOST=dahost11.vpslocal.co.za

FTP_USER=your_cpanel_user
FTP_PASS='your-ftp-password'

# Path relative to the FTP login root. It depends on how the account is jailed:
#   jailed to the docroot (this host, confirmed 2026-10-29):  /
#   primary cPanel login (whole home directory):              public_html
FTP_REMOTE_DIR=/

# 1 = connect by IP and skip certificate checks (only if the hostname fails).
FTP_INSECURE=0

SITE_URL=https://invigismart.online

# --- backend (deploy/upload-passenger.sh, DEPLOY.md section 13) --------------
# The application root cPanel's "Setup Python App" created, relative to the FTP
# login root. Three cases:
#   dedicated account jailed to the app root   -> /
#   primary cPanel login (whole home dir)      -> invigismart-api
#   account jailed to the docroot (this host)  -> cannot see it at all
# The primary login is *not* one of the plan's FTP accounts, so it still works
# when "FTP Accounts" refuses another with "You have reached the limit":
# FTP_USER=<cPanel username, no @domain>, FTP_PASS=<cPanel password>, and then
# the static target above becomes FTP_REMOTE_DIR=public_html ("/" is the home
# directory there, not the docroot). A 530 on that login means the password was
# the FTP account's, not the cPanel one.
# Or skip FTP entirely: ./deploy/upload-passenger.sh --zip, then File Manager's
# Upload + Extract - no credentials involved.
BACKEND_REMOTE_DIR=/

# Hostname the API is served on - only used to verify a deployment.
API_HOST=api.invigismart.online
