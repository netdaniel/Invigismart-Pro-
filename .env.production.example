# ---------------------------------------------------------------------------
# Invigismart Pro - PRODUCTION configuration template.
#
#   sudo install -m 600 .env.production.example /etc/invigismart.env
#   sudo nano /etc/invigismart.env          # fill in every REQUIRED value
#
# Then start the service (see DEPLOY.md):
#   systemctl start invigismart
#
# The server REFUSES TO START when APP_BASE_URL is an https host and any
# REQUIRED value below is missing. That rule exists because the failure mode is
# silent: a school pays R1200 and the licence never unlocks. See
# "production safety review" in server/config.py.
#
# ALLOW_INSECURE_BILLING=1 skips those checks. Disposable staging hosts only.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
# REQUIRED: bind loopback only. TLS is terminated by the reverse proxy that
# sits in front of the app (there is no TLS inside this server).
HOST=127.0.0.1
PORT=8080
# REQUIRED: absolute path on persistent storage, writable by the service user.
# A path inside the checkout (server/invigismart.db) loses every subscription
# on the next deploy.
DB_PATH=/var/lib/invigismart/invigismart.db
# STRONGLY RECOMMENDED: keep uploaded school PDFs out of the checkout, on the
# same persistent volume as the database. Create it and make it writable by the
# service user (see DEPLOY.md step 1). Defaults to server/uploads, which a
# deploy would replace.
DOCUMENTS_DIR=/var/lib/invigismart/documents
# Per-file limit, per-account file count and total storage allowance.
MAX_DOCUMENT_BYTES=10485760
MAX_DOCUMENTS_PER_USER=50
MAX_DOCUMENT_STORAGE_BYTES=104857600

# --- sessions ---------------------------------------------------------------
# REQUIRED: python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable - changing it signs every customer out.
JWT_SECRET=
ACCESS_TOKEN_TTL=3600
# Trial length for newly registered schools (server-enforced).
TRIAL_DAYS=14

# --- public URL -------------------------------------------------------------
# REQUIRED: the address customers actually type, scheme included and no
# trailing slash. Used for the payment success/cancel redirects and the ITN
# that tells us a school has paid.
APP_BASE_URL=https://roster.your-school-domain.co.za

# --- billing provider -------------------------------------------------------
# payfast | stripe | mock. Leave blank to auto-detect from whichever
# credentials are present. Stripe is only available to South African businesses
# through its "extended network", so this deployment uses PayFast - the local
# gateway, which supports annual ZAR recurring billing and can cancel a
# subscription through its API.
BILLING_PROVIDER=payfast

# --- PayFast (South Africa) --------------------------------------------------
# REQUIRED for live payments. Everything here comes from your PayFast account:
#   1. Log in to PayFast -> Settings -> Integration.
#   2. Copy the Merchant ID and Merchant Key.
#   3. Set a Passphrase there and put the SAME value here. PayFast signs the
#      payment form with it, so a mismatch means the checkout is rejected and
#      the school cannot pay at all.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# 1 = test against the PayFast sandbox and take no real money. MUST be 0 here.
PAYFAST_SANDBOX=0
# 6 = annual. Confirm the cadence on the first sandbox payment: your PayFast
# dashboard shows the next scheduled collection date.
PAYFAST_FREQUENCY=6
# 0 = renew until cancelled.
PAYFAST_CYCLES=0
# How an incoming ITN is proved genuine:
#   api            - ask PayFast directly (default, and recommended)
#   api+signature  - also re-compute the local md5 signature
#   signature      - offline check only
#   off            - never (tests only)
PAYFAST_ITN_VERIFICATION=api
# Optional: pin notifications to PayFast's own addresses (comma-separated IPs or
# CIDRs). Empty skips the check, exactly as PayFast's own plugin does.
PAYFAST_IP_ALLOWLIST=

# --- Stripe (alternative, only if your entity is Stripe-supported) -----------
# step 1: add a product with a RECURRING price of R1200 ZAR yearly.
# step 2: webhook endpoint https://<your-domain>/api/billing/webhook with
#         checkout.session.completed, customer.subscription.* and invoice.paid.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- billing mode -----------------------------------------------------------
# Keep at 0 in production. 1 publishes /mock-checkout and
# /api/billing/mock-activate, where any signed-in visitor can mint themself a
# free year. It is forced off whenever APP_BASE_URL is https, but state the
# intent explicitly here.
ALLOW_MOCK_BILLING=0

# --- escape hatch (never 1 in production) -----------------------------------
# 1 skips the production billing checks in server/config.py.
ALLOW_INSECURE_BILLING=

# --- plan copy shown in the UI and the mock checkout ------------------------
# Values with spaces are quoted for `set -a; . ./.env.production`.
PLAN_NAME="Annual School Unlimited"
# ZAR. Keep in sync with the gateway's price.
PLAN_PRICE_DISPLAY="R1200 / year"
# The amount actually charged, in ZAR: it builds the payment form and is used to
# reject a payment that falls short of the price.
PLAN_PRICE_AMOUNT=1200.00
# How long one paid period lasts, in days.
SUBSCRIPTION_DAYS=365

# --- contact details shown on the site --------------------------------------
# REQUIRED in practice, though there is no boot guard for it: this is the only
# route a school has when a payment will not go through, an invoice is queried,
# or a lapsed account is locked out (there is still no self-service password
# reset). Printed on the landing page, the dashboard footer and the billing
# panel. Set the inbox you actually read; blank falls back to the live address.
SUPPORT_EMAIL=daniel@invigismart.online
# Accepts 076 319 3749, +27 76 319 3749 or 0027763193749; the tel: and WhatsApp
# links are derived from it. Use a number that rings somewhere monitored.
SUPPORT_PHONE="+27 76 319 3749"
